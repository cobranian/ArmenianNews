{
  "name": "armenian-news",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Arménie Info - a daily snapshot of Armenian news, events and social media",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-sites.mjs",
    "build:one": "vite build",
    "preview": "vite preview --outDir dist/ch",
    "preview:org": "vite preview --outDir dist/org",
    "lint": "eslint .",
    "test": "node --test test/*.mjs",
    "check": "node scripts/check-build.mjs",
    "scrape": "node scripts/scrape.mjs",
    "ig-scrape": "node scripts/ig-scrape.mjs",
    "ig-select": "node scripts/ig-select.mjs",
    "reencode": "node scripts/reencode-images.mjs",
    "fb-scrape": "node scripts/fb-scrape.mjs",
    "screenshot": "node scripts/shoot.mjs",
    "radio-check": "node scripts/radio-check.mjs",
    "og-image": "node scripts/og-image.mjs",
    "prerender": "node scripts/prerender.mjs",
    "fonts-sync": "node scripts/fonts-sync.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "puppeteer-core": "^25.6.0",
    "sharp": "^0.35.3",
    "vite": "^6.0.7"
  }
}
